+/* BOCETO tarea 106, paso 0 -solo para las laminas, no va a main-. Solo tokens de styles.css. */
+.vf-selector-bloque { display: flex; flex-direction: column; gap: 8px; padding: 0 0 12px; }
+.vf-selector { display: grid; grid-template-columns: 1fr 1fr; height: 48px; border-radius: 999px; border: 1px solid var(--borde-tarjeta); overflow: hidden; }
+.vf-selector-mitad { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: none; background: transparent; color: var(--color-texto); font-size: 14px; font-weight: 500; }
+.vf-selector-mitad + .vf-selector-mitad { border-left: 1px solid var(--borde-tarjeta); }
+.vf-selector-mitad.elegida { background: var(--color-acento); color: var(--color-texto-acento); }
+.vf-explicacion { font-size: 13px; color: var(--color-apagado); padding: 0 4px; }
+.vf-tarjeta-velocidad { margin: 4px 0 0; }
+.vf-tarjeta-velocidad .fila-ajuste { padding-right: 8px; }
+.vf-menu-icono { display: inline-flex; margin-right: 12px; color: var(--color-apagado); }
+.vf-ficha-ancla { display: inline-flex; }
+.vf-ficha-abajo { flex-direction: column; align-items: center; gap: 4px; }
+.vf-menos { display: block; width: 14px; height: 1.6px; border-radius: 1px; background: currentColor; }
+/* La pastilla: el vidrio de las fichas del dock -blanco 7 %, borde blanco 10 %-. */
+.vf-control { display: inline-flex; align-items: center; gap: 6px; height: 48px; padding: 0 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.10); color: var(--color-texto); flex: 0 0 auto; }
+.vf-control.vertical { flex-direction: column; height: auto; width: 48px; padding: 4px 0; }
+.vf-boton-nivel { width: 40px; height: 40px; border-radius: 999px; border: none; background: transparent; color: var(--color-texto); display: flex; align-items: center; justify-content: center; }
+.vf-boton-nivel:disabled { opacity: 0.38; }
+.vf-barra { display: inline-flex; gap: 3px; align-items: center; }
+.vf-barra.vertical { flex-direction: column; }
+.vf-tramo { width: 8px; height: 16px; border-radius: 2px; background: rgba(255, 255, 255, 0.10); }
+.vf-barra.vertical .vf-tramo { width: 16px; height: 8px; }
+.vf-tramo.lleno { background: var(--color-acento); }
+.vf-barra.chica { gap: 2px; }
+.vf-barra.chica .vf-tramo { width: 4px; height: 8px; border-radius: 1px; }
+.vf-rotulo-barra { display: inline-flex; height: 14px; align-items: center; }
+.vf-menu-velocidad { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 12px 6px; border-top: 1px solid var(--borde-tarjeta); margin-top: 6px; }
+.vf-en-fila { display: flex; flex-direction: column; align-items: center; gap: 4px; pointer-events: auto; }
+.vf-en-fila.al-borde { position: fixed; right: 12px; bottom: calc(var(--circulo-desde-abajo, 40px) - 40px); }
+.vf-leyendo-fija [data-testid="capa-destacado"] { display: none; }
+.vf-linea-modo { display: flex; align-items: center; gap: 8px; padding: 0 0 10px; }
+.dock-lugar-voltear { gap: 8px; align-items: flex-start; }
+.vf-linea-modo .vf-ficha-abajo { flex-direction: row; gap: 10px; }
+.vf-riel-izq { position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%); display: flex; justify-content: center; z-index: 100; }
