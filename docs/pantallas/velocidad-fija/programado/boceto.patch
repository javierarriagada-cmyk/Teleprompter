index 0000000..0cc2a70
--- /dev/null
+++ b/src/components/BocetoVelocidad.tsx
@@ -0,0 +1,184 @@
+// BOCETO -tarea 106 «Velocidad fija», paso 0, segunda vuelta 14-10-2026-. SOLO PARA LAS LAMINAS: vive
+// en un worktree aparte y no va a main. Armado con los componentes y las clases de verdad -FilaAjuste,
+// MenuAdjuntoAjustes, ficha-listo, dock-rotulo-chico-. Se enciende con localStorage boceto_vf = '1';
+// boceto_vf_modo = 'voz' | 'fija' -por omision 'fija'-; boceto_vf_nivel = 1..7 -por omision 4-;
+// boceto_vf_menu = 'ficha' abre el menu de la ficha; boceto_vf_lectura = 'vertical' dibuja la propuesta
+// de la lectura de pie; boceto_vf_grabar = 'fila' | 'derecha' elige donde va la ficha en Grabar.
+import React, { useEffect, useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+import { IconoMicrofono, IconoVelocimetro, IconoMas } from './IconosApp'
+import { FilaAjuste, MenuAdjuntoAjustes, CheckMenu } from './FilasAjustesLectura'
+import './boceto-velocidad.css'
+
+export type ModoLectura = 'voz' | 'fija'
+// SIETE NIVELES, cada uno 14 % mas rapido que el anterior. Las palabras por minuto solo mueven el texto
+// y calculan la duracion: nunca se muestran.
+export const NIVELES_PPM = [100, 114, 130, 148, 169, 193, 220]
+export const NIVEL_POR_OMISION = 4
+
+function ls(k: string): string | null {
+  try { return localStorage.getItem(k) } catch { return null }
+}
+export function bocetoActivo(): boolean { return ls('boceto_vf') === '1' }
+export function modoBoceto(): ModoLectura { return ls('boceto_vf_modo') === 'voz' ? 'voz' : 'fija' }
+export function fichaAbajo(): boolean { return true } // aprobado: abajo a la izquierda en Leer
+export function lecturaVertical(): boolean { return ls('boceto_vf_lectura') === 'vertical' }
+export function grabarDonde(): string { return ls('boceto_vf_grabar') || 'fila' }
+function menuAbiertoAlEntrar(cual: string): boolean { return ls('boceto_vf_menu') === cual }
+
+// El nivel, compartido: cada toque cambia la duracion donde se vea.
+let nivelActual = Math.min(7, Math.max(1, Number(ls('boceto_vf_nivel')) || NIVEL_POR_OMISION))
+const oyentes = new Set<(n: number) => void>()
+export function useNivel(): [number, (n: number) => void] {
+  const [n, setN] = useState(nivelActual)
+  useEffect(() => { oyentes.add(setN); return () => { oyentes.delete(setN) } }, [])
+  return [n, (v: number) => { nivelActual = Math.min(7, Math.max(1, v)); oyentes.forEach((f) => f(nivelActual)) }]
+}
+export function duracionConNivel(palabras: number, nivel: number): string {
+  const s = Math.round((palabras / NIVELES_PPM[nivel - 1]) * 60)
+  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`
+}
+
+// La barra de siete tramos, llena hasta el nivel.
+export function BarraNivel({ nivel, vertical = false, chica = false }: { nivel: number; vertical?: boolean; chica?: boolean }) {
+  const tramos = Array.from({ length: 7 }, (_, i) => i + 1)
+  return (
+    <span className={`vf-barra${vertical ? ' vertical' : ''}${chica ? ' chica' : ''}`} aria-hidden="true">
+      {(vertical ? [...tramos].reverse() : tramos).map((t) => (
+        <span key={t} className={`vf-tramo${t <= nivel ? ' lleno' : ''}`} />
+      ))}
+    </span>
+  )
+}
+
+// EL UNICO CONTROL DE VELOCIDAD: una pastilla con − a la izquierda, + a la derecha y la barra entre
+// ellos. De lado va parado: + arriba, la barra y − abajo.
+export function ControlVelocidad({ vertical = false }: { vertical?: boolean }) {
+  const [nivel, setNivel] = useNivel()
+  const menos = (
+    <button type="button" className="vf-boton-nivel" disabled={nivel <= 1} aria-label="Más lento"
+      onClick={(e) => { e.stopPropagation(); setNivel(nivel - 1) }}>
+      <span className="vf-menos" aria-hidden="true" />
+    </button>
+  )
+  const mas = (
+    <button type="button" className="vf-boton-nivel" disabled={nivel >= 7} aria-label="Más rápido"
+      onClick={(e) => { e.stopPropagation(); setNivel(nivel + 1) }}>
+      <IconoMas tamano={18} />
+    </button>
+  )
+  return (
+    <div className={`vf-control${vertical ? ' vertical' : ''}`} role="group" aria-label={`Velocidad, nivel ${nivel} de 7`}
+      data-testid="control-velocidad" onClick={(e) => e.stopPropagation()}>
+      {vertical ? mas : menos}
+      <BarraNivel nivel={nivel} vertical={vertical} />
+      {vertical ? menos : mas}
+    </div>
+  )
+}
+
+// Los menus van afuera del vidrio, en el lugar de los menus del dock -como los de PanelAjustes-.
+function afuera(n: React.ReactNode) {
+  const host = document.querySelector('.menus-dock') as HTMLElement | null
+  return createPortal(n, host ?? document.body)
+}
+
+// El selector de Material 3 en dos mitades, con su linea de explicacion.
+export function SelectorModo() {
+  const [modo, setModo] = useState<ModoLectura>(modoBoceto())
+  return (
+    <div className="vf-selector-bloque">
+      <div className="vf-selector" role="radiogroup" aria-label="Modo de lectura">
+        {([['voz', <IconoMicrofono tamano={18} />, 'Con la voz'], ['fija', <IconoVelocimetro tamano={18} />, 'Velocidad fija']] as const).map(([v, ic, n]) => (
+          <button key={v} type="button" role="radio" aria-checked={modo === v}
+            className={`vf-selector-mitad${modo === v ? ' elegida' : ''}`} onClick={() => setModo(v)}>
+            {ic}<span>{n}</span>
+          </button>
+        ))}
+      </div>
+      <div className="vf-explicacion">
+        {modo === 'voz' ? 'El texto sigue tu voz.' : 'El texto sube solo, a la velocidad que elijas.'}
+      </div>
+      {modo === 'fija' && (
+        <div className="tarjeta-seccion-ajustes vf-tarjeta-velocidad">
+          {/* La fila de hoy con el control adentro, a la derecha del nombre: sin menu de opciones. */}
+          <FilaAjuste testid="fila-velocidad" icono={<IconoVelocimetro tamano={22} />} nombre="Velocidad"
+            extra={<ControlVelocidad />} />
+        </div>
+      )}
+    </div>
+  )
+}
+
+// La ficha del modo, abajo a la izquierda en LISTO de Leer -aprobada-, con su menu adjunto. Debajo, chico,
+// «sigue tu voz» o la barra del nivel.
+export function FichaModo({ compacta = false, abajo = false }: { compacta?: boolean; abajo?: boolean }) {
+  const modo = modoBoceto()
+  const [nivel] = useNivel()
+  const ancla = useRef<HTMLDivElement>(null)
+  const [abierto, setAbierto] = useState(menuAbiertoAlEntrar('ficha'))
+  return (
+    <div ref={ancla} className={`vf-ficha-ancla${abajo ? ' vf-ficha-abajo' : ''}`}>
+      <button type="button" className={`ficha-listo${abierto ? ' abierta' : ''}`} data-testid="ficha-modo"
+        aria-label={modo === 'voz' ? 'Con la voz' : `Velocidad fija, nivel ${nivel} de 7`}
+        aria-expanded={abierto} onClick={() => setAbierto(!abierto)}>
+        {modo === 'voz' ? <IconoMicrofono tamano={16} /> : <IconoVelocimetro tamano={16} />}
+        {compacta
+          ? (modo === 'voz' ? <span>Voz</span> : <BarraNivel nivel={nivel} chica />)
+          : <span>{modo === 'voz' ? 'Con la voz' : 'Velocidad fija'}</span>}
+      </button>
+      {abajo && (modo === 'fija'
+        ? <span className="dock-rotulo-chico vf-rotulo-barra"><BarraNivel nivel={nivel} chica /></span>
+        : <span className="dock-rotulo-chico">sigue tu voz</span>)}
+      {abierto && afuera(
+        <MenuAdjuntoAjustes anclaRef={ancla} onCerrar={() => setAbierto(false)} testid="dialogo-modo">
+          <div className="lista-menu-adjunto">
+            {([['voz', <IconoMicrofono tamano={20} />, 'Con la voz'], ['fija', <IconoVelocimetro tamano={20} />, 'Velocidad fija']] as const).map(([v, ic, n]) => (
+              <button key={v} type="button" className={`fila-menu-adjunto${modo === v ? ' elegida' : ''}`}
+                role="menuitemradio" aria-checked={modo === v}>
+                <span className="vf-menu-icono">{ic}</span>
+                <span className="fila-menu-adjunto-etiqueta">{n}</span>
+                <CheckMenu visible={modo === v} />
+              </button>
+            ))}
+          </div>
+          {modo === 'fija' && (
+            <div className="vf-menu-velocidad">
+              <span className="dock-rotulo-chico">velocidad</span>
+              <ControlVelocidad />
+            </div>
+          )}
+        </MenuAdjuntoAjustes>
+      )}
+    </div>
+  )
+}
+
+// La lectura en Velocidad fija: el control en el lugar vacio de la fila de la toma -el de la derecha-.
+// De pie va acostado; la propuesta y de lado, parado. Con su rotulo chico «velocidad».
+export function ControlEnFilaDeLaToma({ horizontal }: { horizontal: boolean }) {
+  // Solo boceto: el renglon de arriba al 100 % y el resto al 45 %, sin linea bajo las palabras.
+  useEffect(() => {
+    document.body.classList.add('vf-leyendo-fija')
+    const pintar = () => {
+      const fichas = Array.from(document.querySelectorAll('[data-testid="columna-texto"] [data-token]')) as HTMLElement[]
+      const visibles = fichas.filter((f) => f.getBoundingClientRect().top >= 0)
+      if (!visibles.length) return
+      const arriba = Math.min(...visibles.map((f) => f.getBoundingClientRect().top))
+      for (const f of fichas) {
+        f.style.color = 'var(--color-texto)'
+        f.style.opacity = Math.abs(f.getBoundingClientRect().top - arriba) < 4 ? '1' : '0.45'
+      }
+    }
+    pintar()
+    const id = window.setInterval(pintar, 300)
+    return () => { window.clearInterval(id); document.body.classList.remove('vf-leyendo-fija') }
+  }, [])
+  const vertical = horizontal || lecturaVertical()
+  return (
+    <div className={`vf-en-fila${vertical ? ' vertical' : ''}${!horizontal && vertical ? ' al-borde' : ''}`} data-testid="vf-en-fila">
+      <ControlVelocidad vertical={vertical} />
+      <span className="dock-rotulo-chico">velocidad</span>
+    </div>
+  )
+}
