@@ -0,0 +1,37 @@
+/* BOCETO tarea 106, paso 0 -solo para las laminas, no va a main-. Solo tokens de styles.css. */
+.vf-selector-bloque { display: flex; flex-direction: column; gap: 8px; padding: 0 0 12px; }
+.vf-selector {
+  display: grid; grid-template-columns: 1fr 1fr; height: 48px; border-radius: 999px;
+  border: 1px solid var(--borde-tarjeta); overflow: hidden;
+}
+.vf-selector-mitad {
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: none;
+  background: transparent; color: var(--color-texto); font-size: 14px; font-weight: 500;
+}
+.vf-selector-mitad + .vf-selector-mitad { border-left: 1px solid var(--borde-tarjeta); }
+.vf-selector-mitad.elegida { background: var(--color-acento); color: var(--color-texto-acento); }
+.vf-explicacion { font-size: 13px; color: var(--color-apagado); padding: 0 4px; }
+.vf-tarjeta-velocidad { margin: 4px 0 0; }
+.vf-lista-velocidades { position: relative; }
+.vf-lista-velocidades { max-height: 60vh; overflow-y: auto; }
+.vf-menu-icono { display: inline-flex; margin-right: 12px; color: var(--color-apagado); }
+.vf-ficha-ancla { display: inline-flex; }
+.vf-menos { display: block; width: 14px; height: 1.6px; border-radius: 1px; background: currentColor; }
+.vf-menos-mas {
+  display: flex; align-items: center; justify-content: space-between; gap: 8px;
+  padding: 8px 12px 6px; border-top: 1px solid var(--borde-tarjeta); margin-top: 6px;
+}
+.vf-menos-mas-valor { font-size: 16px; font-weight: 700; color: var(--color-texto); display: inline-flex; flex-direction: column; align-items: center; }
+.vf-circulo-chico {
+  width: 40px; height: 40px; border-radius: 999px; display: flex; align-items: center; justify-content: center;
+  background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.10); color: var(--color-texto);
+}
+.vf-circulo-chico:disabled, .dock-voltear:disabled { opacity: 0.38; }
+.vf-circulo-48 { width: 48px; height: 48px; }
+.vf-fila-lectura { width: 100%; box-sizing: border-box; padding: 0 12px; pointer-events: auto; }
+.vf-leyendo-fija [data-testid="capa-destacado"] { display: none; }
+.vf-centro-lectura { position: relative; display: flex; align-items: center; }
+.vf-centro-lectura > .dock-voltear { position: absolute; left: calc(100% + 16px); top: 50%; transform: translateY(-50%); }
+.vf-columna-lectura { display: flex; flex-direction: column; align-items: center; gap: 12px; }
+.vf-velocidad-columna { min-width: 0; padding: 0; justify-self: auto; }
+.vf-ficha-abajo { flex-direction: column; align-items: center; gap: 4px; }
