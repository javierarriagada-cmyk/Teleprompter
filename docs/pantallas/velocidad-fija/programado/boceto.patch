+// BOCETO -tarea 106 «Velocidad fija», paso 0-. SOLO PARA LAS LAMINAS: vive en un worktree aparte y
+// no va a main. Las piezas nuevas, armadas con los componentes y las clases de verdad -FilaAjuste,
+// MenuAdjuntoAjustes, ficha-listo, dock-voltear-circulo, dock-duracion-. El modo se fuerza con
+// localStorage boceto_vf_modo = 'voz' | 'fija' -por omision 'fija'- y la velocidad es 150.
+import React, { useEffect, useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+import { IconoMicrofono, IconoVelocimetro, IconoMas } from './IconosApp'
+import { FilaAjuste, MenuAdjuntoAjustes, CheckMenu } from './FilasAjustesLectura'
+import './boceto-velocidad.css'
+
+export type ModoLectura = 'voz' | 'fija'
+export const VELOCIDAD_BOCETO = 150
+export const VELOCIDADES = Array.from({ length: 15 }, (_, i) => 80 + i * 10)
+
+export function modoBoceto(): ModoLectura {
+  try { return localStorage.getItem('boceto_vf_modo') === 'voz' ? 'voz' : 'fija' } catch { return 'fija' }
+}
+export function bocetoActivo(): boolean {
+  try { return localStorage.getItem('boceto_vf') === '1' } catch { return false }
+}
+export function fichaAbajo(): boolean {
+  try { return localStorage.getItem('boceto_vf_ficha') === 'abajo' } catch { return false }
+}
+function menuAbiertoAlEntrar(cual: string): boolean {
+  try { return localStorage.getItem('boceto_vf_menu') === cual } catch { return false }
+}
+
+// El selector de Material 3 en dos mitades, con su linea de explicacion.
+export function SelectorModo() {
+  const [modo, setModo] = useState<ModoLectura>(modoBoceto())
+  return (
+    <div className="vf-selector-bloque">
+      <div className="vf-selector" role="radiogroup" aria-label="Modo de lectura">
+        {([['voz', <IconoMicrofono tamano={18} />, 'Con la voz'], ['fija', <IconoVelocimetro tamano={18} />, 'Velocidad fija']] as const).map(([v, ic, n]) => (
+          <button key={v} type="button" role="radio" aria-checked={modo === v}
+            className={`vf-selector-mitad${modo === v ? ' elegida' : ''}`} onClick={() => setModo(v)}>
+            {ic}<span>{n}</span>
+          </button>
+        ))}
+      </div>
+      <div className="vf-explicacion">
+        {modo === 'voz' ? 'El texto sigue tu voz.' : 'El texto sube solo, a la velocidad que elijas.'}
+      </div>
+      {modo === 'fija' && <TarjetaVelocidad />}
+    </div>
+  )
+}
+
+// Los menus van afuera del vidrio, en el lugar de los menus del dock -como los de PanelAjustes-.
+function afuera(n: React.ReactNode) {
+  const host = document.querySelector('.menus-dock') as HTMLElement | null
+  return createPortal(n, host ?? document.body)
+}
+
+function ListaVelocidades() {
+  const ref = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    const l = ref.current
+    const e = l?.querySelector('.elegida') as HTMLElement | null
+    if (l && e) l.scrollTop = e.offsetTop - l.clientHeight / 2 + e.offsetHeight / 2
+  }, [])
+  return (
+    <div ref={ref} className="lista-menu-adjunto vf-lista-velocidades">
+      {VELOCIDADES.map((v) => (
+        <button key={v} type="button" className={`fila-menu-adjunto${v === VELOCIDAD_BOCETO ? ' elegida' : ''}`}
+          role="menuitemradio" aria-checked={v === VELOCIDAD_BOCETO}>
+          <span className="fila-menu-adjunto-etiqueta">{v} palabras/min</span>
+          <CheckMenu visible={v === VELOCIDAD_BOCETO} />
+        </button>
+      ))}
+    </div>
+  )
+}
+
+function TarjetaVelocidad() {
+  const ancla = useRef<HTMLDivElement>(null)
+  const [abierto, setAbierto] = useState(menuAbiertoAlEntrar('velocidad'))
+  return (
+    <div className="tarjeta-seccion-ajustes vf-tarjeta-velocidad">
+      <div className="envoltorio-fila-con-menu" ref={ancla}>
+        <FilaAjuste testid="fila-velocidad" icono={<IconoVelocimetro tamano={22} />} nombre="Velocidad"
+          valor={`${VELOCIDAD_BOCETO} palabras/min`} onClick={() => setAbierto(!abierto)} />
+      </div>
+      {abierto && afuera(
+        <MenuAdjuntoAjustes anclaRef={ancla} onCerrar={() => setAbierto(false)} testid="dialogo-velocidad">
+          <ListaVelocidades />
+        </MenuAdjuntoAjustes>
+      )}
+    </div>
+  )
+}
+
+// El - y el + de la velocidad, con la regla de los topes: - apagado en 80, + apagado en 220.
+export function MenosMas({ velocidad = VELOCIDAD_BOCETO }: { velocidad?: number }) {
+  return (
+    <div className="vf-menos-mas">
+      <button type="button" className="vf-circulo-chico" disabled={velocidad <= 80} aria-label="Más lento">
+        <span className="vf-menos" aria-hidden="true" />
+      </button>
+      <span className="vf-menos-mas-valor">{velocidad} <span className="dock-rotulo-chico">palabras/min</span></span>
+      <button type="button" className="vf-circulo-chico" disabled={velocidad >= 220} aria-label="Más rápido">
+        <IconoMas tamano={18} />
+      </button>
+    </div>
+  )
+}
+
+// La ficha del modo, primera de la fila, con su menu adjunto.
+export function FichaModo({ compacta = false, abajo = false }: { compacta?: boolean; abajo?: boolean }) {
+  const modo = modoBoceto()
+  const ancla = useRef<HTMLDivElement>(null)
+  const [abierto, setAbierto] = useState(menuAbiertoAlEntrar('ficha'))
+  const nombre = modo === 'voz'
+    ? (compacta ? 'Voz' : 'Con la voz')
+    : (compacta ? String(VELOCIDAD_BOCETO) : abajo ? 'Velocidad fija' : `Velocidad fija · ${VELOCIDAD_BOCETO}`)
+  return (
+    <div ref={ancla} className={`vf-ficha-ancla${abajo ? ' vf-ficha-abajo' : ''}`}>
+      <button type="button" className={`ficha-listo${abierto ? ' abierta' : ''}`} data-testid="ficha-modo"
+        aria-expanded={abierto} onClick={() => setAbierto(!abierto)}>
+        {modo === 'voz' ? <IconoMicrofono tamano={16} /> : <IconoVelocimetro tamano={16} />}
+        <span>{nombre}</span>
+      </button>
+      {abajo && <span className="dock-rotulo-chico">{modo === 'fija' ? `${VELOCIDAD_BOCETO} palabras/min` : 'sigue tu voz'}</span>}
+      {abierto && afuera(
+        <MenuAdjuntoAjustes anclaRef={ancla} onCerrar={() => setAbierto(false)} testid="dialogo-modo">
+          <div className="lista-menu-adjunto">
+            {([['voz', <IconoMicrofono tamano={20} />, 'Con la voz'], ['fija', <IconoVelocimetro tamano={20} />, 'Velocidad fija']] as const).map(([v, ic, n]) => (
+              <button key={v} type="button" className={`fila-menu-adjunto${modo === v ? ' elegida' : ''}`}
+                role="menuitemradio" aria-checked={modo === v}>
+                <span className="vf-menu-icono">{ic}</span>
+                <span className="fila-menu-adjunto-etiqueta">{n}</span>
+                <CheckMenu visible={modo === v} />
+              </button>
+            ))}
+          </div>
+          {modo === 'fija' && <MenosMas />}
+        </MenuAdjuntoAjustes>
+      )}
+    </div>
+  )
+}
+
+// La fila de abajo al leer en Velocidad fija: - a la izquierda, la Pausa de hoy al centro con el + a
+// su derecha, y la velocidad donde hoy va la duracion.
+export function FilaLecturaFija({ pausa, horizontal = false }: { pausa: React.ReactNode; horizontal?: boolean }) {
+  // Solo boceto: sin linea bajo las palabras, y el renglon de arriba -el que se lee- en --color-texto
+  // al 100 % y el resto al 45 %.
+  useEffect(() => {
+    document.body.classList.add('vf-leyendo-fija')
+    const pintar = () => {
+      const fichas = Array.from(document.querySelectorAll('[data-testid="columna-texto"] [data-token]')) as HTMLElement[]
+      const visibles = fichas.filter((f) => f.getBoundingClientRect().top >= 0)
+      if (!visibles.length) return
+      const arriba = Math.min(...visibles.map((f) => f.getBoundingClientRect().top))
+      for (const f of fichas) {
+        const enLinea = Math.abs(f.getBoundingClientRect().top - arriba) < 4
+        f.style.color = 'var(--color-texto)'
+        f.style.opacity = enLinea ? '1' : '0.45'
+      }
+    }
+    pintar()
+    const id = window.setInterval(pintar, 300)
+    return () => { window.clearInterval(id); document.body.classList.remove('vf-leyendo-fija') }
+  }, [])
+  const menos = (
+    <button type="button" className="dock-voltear" aria-label="Más lento">
+      <span className="dock-voltear-circulo vf-circulo-48" aria-hidden="true"><span className="vf-menos" /></span>
+    </button>
+  )
+  const mas = (
+    <button type="button" className="dock-voltear" aria-label="Más rápido">
+      <span className="dock-voltear-circulo vf-circulo-48" aria-hidden="true"><IconoMas tamano={20} /></span>
+    </button>
+  )
+  const velocidad = (
+    <>
+      <span className="dock-duracion">{VELOCIDAD_BOCETO}</span>
+      <span className="dock-rotulo-chico">palabras/min</span>
+      <span className="dock-rotulo-chico">velocidad</span>
+    </>
+  )
+  if (horizontal) {
+    return (
+      <div className="vf-columna-lectura" onClick={(e) => e.stopPropagation()}>
+        {mas}
+        {pausa}
+        {menos}
+        <div className="dock-lugar-duracion vf-velocidad-columna">{velocidad}</div>
+      </div>
+    )
+  }
+  return (
+    <div className="dock-fila-abajo vf-fila-lectura" onClick={(e) => e.stopPropagation()}>
+      <div className="dock-lugar-voltear">{menos}</div>
+      <div className="vf-centro-lectura">{pausa}{mas}</div>
+      <div className="dock-lugar-duracion">{velocidad}</div>
+    </div>
+  )
+}
