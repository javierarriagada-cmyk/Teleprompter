<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- EL MUNDO ES OSCURO SIEMPRE, tarea 50. La aplicacion ya no sigue al tema
             del telefono, asi que este values/ -el claro del sistema- lleva los
             mismos valores que values-night/.

             El fondo NO es @null: es lo que se ve DETRAS de las barras de sistema.
             Desde targetSdk 35 android:statusBarColor y navigationBarColor se
             ignoran y el borde a borde es obligatorio, asi que la unica manera de
             que esas barras sean negras es que lo que hay debajo sea negro.
             -borde-a-borde, 03-11-2026-: eso de ignorar statusBarColor/navigationBarColor
             vale solo en Android 15 y posteriores. En Android 10 a 14 esos colores
             pintaban las franjas de las barras -gris arriba y blanca abajo en un
             Galaxy A15 con Android 14, durante la lectura-. Desde esta tarea esas
             versiones también van de borde a borde -MainActivity llama a
             WindowCompat.enableEdgeToEdge cuando la WebView es 140 o más-, y el
             fondo de Sigo es lo que se ve detrás, igual que en 15/16.

             windowLight*Bar en false pide iconos CLAROS de sistema, que es lo que
             se lee sobre nuestro negro. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_arranque</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/marca_arranque_animada</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>