<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- hasFragileUserData -24-09-2026-: las tomas que no se guardaron en la
         galeria viven en la carpeta privada de Sigo, que la galeria no muestra
         -Javier eligio que queden escondidas-. Esa carpeta se borraba entera al
         desinstalar: ese dia se perdieron asi las tomas de la app vieja. Con esto,
         al desinstalar, Android pregunta si conservar los datos de la app. -->
    <!-- localeConfig -27-09-2026, docs/ingles.txt D1-: los idiomas que la app ofrece, para
         que Android 13 o mas nuevo muestre el selector en Ajustes -> Apps -> Sigo -> Idioma. -->
    <application
        android:hasFragileUserData="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- layoutDirection -27-09-2026-: cambiar el idioma de la app -IdiomaAppPlugin- trae
             locale Y layoutDirection. Sin el segundo, Android reinicia la actividad y la
             pagina se recarga en medio de lo que se estaba haciendo. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- EL IDIOMA ELEGIDO SE RECUERDA TAMBIEN EN ANDROID 12 O ANTERIOR -27-09-2026-. Ahi
             no existe el idioma por app del sistema; AppCompat lo guarda solo con esto. Es la
             receta de la documentacion de AppCompat 1.6+. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- SIN ENVÍO DE ESTADÍSTICAS A GOOGLE -2026-10-04, tarea 88, decisión de Javier-. Sigo declara
             en Play que no recopila datos. MediaPipe -tasks-core, RemoteLoggingClient- manda estadísticas
             de uso por datatransport, y el que las sube es el backend "cct" -CctBackendFactory, de
             transport-backend-cct-. Aquí se quita SOLO ese registro del manifiesto combinado: el servicio
             TransportBackendDiscovery se mezcla -tools:node="merge"- y su meta-data se saca. Las clases
             quedan en el paquete, así que el reconocedor arranca igual -CCTDestination existe; sin ella no
             arrancaría, ver app/build.gradle-; sin backend registrado, datatransport no tiene a dónde subir.
             Esto corta también el envío de ML Kit, que trae capgo/camera-preview -lectura de códigos de
             barras- y que Sigo no usa. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- WRITE_EXTERNAL_STORAGE solo hace falta hasta Android 9 (API 28). Desde Android 10 (API 29) Sigo guarda en la galeria por MediaStore sin necesitar este permiso -28-09-2026-. -->
    <!-- 29-09-2026: el permiso se fue. Con Android 10 como mínimo -variables.gradle- ningún
         teléfono que pueda instalar Sigo lo usaba: quedaba escrito sin efecto. -->
</manifest>
